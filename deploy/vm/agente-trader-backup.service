[Unit]
Description=Agente Trader PostgreSQL backup and checksum
After=docker.service

[Service]
Type=oneshot
User=rafael
WorkingDirectory=/home/rafael/apps/agente-trader
ExecStart=/usr/bin/bash /home/rafael/apps/agente-trader/deploy/vm/backup-postgres.sh
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rafael/apps/agente-trader/data/database_backups
PrivateTmp=true
